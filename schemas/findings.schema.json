{
  "$defs": {
    "AgentClaim": {
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ClaimKind"
        },
        "validated": {
          "default": false,
          "title": "Validated",
          "type": "boolean"
        },
        "rejected_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejected Reason"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        }
      },
      "required": [
        "claim_id",
        "step",
        "text",
        "kind"
      ],
      "title": "AgentClaim",
      "type": "object"
    },
    "AgentTrace": {
      "description": "One agent hand-off: what it consumed, what it produced, how much was accepted.",
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "consumed": {
          "items": {
            "type": "string"
          },
          "title": "Consumed",
          "type": "array"
        },
        "produced": {
          "items": {
            "type": "string"
          },
          "title": "Produced",
          "type": "array"
        },
        "accepted": {
          "default": 0,
          "title": "Accepted",
          "type": "integer"
        },
        "rejected": {
          "default": 0,
          "title": "Rejected",
          "type": "integer"
        },
        "llm_calls": {
          "default": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "agent"
      ],
      "title": "AgentTrace",
      "type": "object"
    },
    "Automatable": {
      "enum": [
        "yes",
        "no",
        "unknown"
      ],
      "title": "Automatable",
      "type": "string"
    },
    "ClaimKind": {
      "enum": [
        "evidence",
        "inference"
      ],
      "title": "ClaimKind",
      "type": "string"
    },
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "Evidence": {
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "pointer": {
          "default": "",
          "title": "Pointer",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "collected_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected At"
        },
        "db_built_at": {
          "default": "UNKNOWN",
          "title": "Db Built At",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "tool",
        "tool_version",
        "file",
        "sha256"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Exploitation": {
      "enum": [
        "active",
        "likely",
        "none",
        "unknown"
      ],
      "title": "Exploitation",
      "type": "string"
    },
    "Exposure": {
      "enum": [
        "open",
        "limited",
        "small"
      ],
      "title": "Exposure",
      "type": "string"
    },
    "Finding": {
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FindingKind"
        },
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "purl": {
          "title": "Purl",
          "type": "string"
        },
        "advisory_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advisory Id"
        },
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "anomaly_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anomaly Type"
        },
        "confirmed_by": {
          "items": {
            "type": "string"
          },
          "title": "Confirmed By",
          "type": "array"
        },
        "source_severity": {
          "default": "UNKNOWN",
          "title": "Source Severity",
          "type": "string"
        },
        "severities": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Severities",
          "type": "object"
        },
        "fixed_versions": {
          "items": {
            "type": "string"
          },
          "title": "Fixed Versions",
          "type": "array"
        },
        "match_basis": {
          "$ref": "#/$defs/MatchBasis",
          "default": "unknown"
        },
        "dependency_path": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Path",
          "type": "array"
        },
        "path_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path Count"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/FindingState",
          "default": "affected"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel",
          "default": "unknown"
        },
        "risk_rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Rule Id"
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Tag"
        },
        "risk_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Note"
        },
        "relevance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Relevance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cvss_vector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvss Vector"
        },
        "cvss_score": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvss Score"
        },
        "epss": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epss"
        },
        "epss_percentile": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epss Percentile"
        },
        "epss_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epss Date"
        },
        "known_exploited": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Exploited"
        },
        "intel_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Intel Evidence Ids",
          "type": "array"
        },
        "ssvc_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/SsvcDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exploitation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Exploitation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exposure": {
          "anyOf": [
            {
              "$ref": "#/$defs/Exposure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "automatable": {
          "anyOf": [
            {
              "$ref": "#/$defs/Automatable"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "technical_impact": {
          "anyOf": [
            {
              "$ref": "#/$defs/TechnicalImpact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "risk_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Score"
        },
        "risk_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Risk Reasons",
          "type": "array"
        },
        "confidence_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Score"
        },
        "review_required": {
          "default": false,
          "title": "Review Required",
          "type": "boolean"
        },
        "review_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Review Reasons",
          "type": "array"
        },
        "engine_risk_level": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskLevel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ai_adjusted": {
          "default": false,
          "title": "Ai Adjusted",
          "type": "boolean"
        },
        "ai_adjustment_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ai Adjustment Reason"
        },
        "ai_adjustment_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Ai Adjustment Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "finding_id",
        "kind",
        "component_id",
        "purl"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingKind": {
      "enum": [
        "vulnerability",
        "malicious",
        "anomaly"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "FindingState": {
      "enum": [
        "affected",
        "not_affected",
        "under_investigation"
      ],
      "title": "FindingState",
      "type": "string"
    },
    "MatchBasis": {
      "enum": [
        "purl",
        "cpe",
        "unknown"
      ],
      "title": "MatchBasis",
      "type": "string"
    },
    "Reachability": {
      "enum": [
        "confirmed",
        "not_detected",
        "unknown"
      ],
      "title": "Reachability",
      "type": "string"
    },
    "Relevance": {
      "description": "Code-computed relevance of a vulnerability or malicious-package finding.",
      "properties": {
        "verdict": {
          "$ref": "#/$defs/RelevanceVerdict",
          "default": "unknown"
        },
        "reachability": {
          "$ref": "#/$defs/Reachability",
          "default": "unknown"
        },
        "introduced_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Introduced By"
        },
        "path_labels": {
          "items": {
            "type": "string"
          },
          "title": "Path Labels",
          "type": "array"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/RelevanceSignal"
          },
          "title": "Signals",
          "type": "array"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "title": "Relevance",
      "type": "object"
    },
    "RelevanceSignal": {
      "description": "One evidence-backed fact used to decide whether a finding matters.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "RelevanceSignal",
      "type": "object"
    },
    "RelevanceVerdict": {
      "enum": [
        "relevant",
        "likely_relevant",
        "low_relevance",
        "unknown"
      ],
      "title": "RelevanceVerdict",
      "type": "string"
    },
    "RiskAdjustment": {
      "additionalProperties": false,
      "description": "The risk analyst's proposed one-level change, kept with its verdict and never merged.",
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "from_level": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "From Level",
          "type": "string"
        },
        "to_level": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "To Level",
          "type": "string"
        },
        "direction": {
          "enum": [
            "raise",
            "lower"
          ],
          "title": "Direction",
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Ids",
          "type": "array"
        },
        "status": {
          "default": "accepted",
          "enum": [
            "accepted",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "rejected_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejected Reason"
        }
      },
      "required": [
        "finding_id",
        "from_level",
        "to_level",
        "direction",
        "reason"
      ],
      "title": "RiskAdjustment",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "SsvcDecision": {
      "enum": [
        "act",
        "attend",
        "track_star",
        "track"
      ],
      "title": "SsvcDecision",
      "type": "string"
    },
    "TechnicalImpact": {
      "enum": [
        "total",
        "partial"
      ],
      "title": "TechnicalImpact",
      "type": "string"
    }
  },
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/AgentClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "agent_trace": {
      "items": {
        "$ref": "#/$defs/AgentTrace"
      },
      "title": "Agent Trace",
      "type": "array"
    },
    "risk_adjustments": {
      "items": {
        "$ref": "#/$defs/RiskAdjustment"
      },
      "title": "Risk Adjustments",
      "type": "array"
    },
    "agreement": {
      "additionalProperties": {
        "type": "boolean"
      },
      "title": "Agreement",
      "type": "object"
    }
  },
  "title": "FindingsArtifact",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
