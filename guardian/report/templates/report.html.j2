<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'">
<title>Guardian scan report</title>
<style>
:root { color-scheme:light; color:#17243b; background:#f2f5f8; font:16px/1.55 system-ui,sans-serif }
body { max-width:72rem; margin:auto; padding:2rem clamp(1rem,4vw,3rem) }
header,section { padding:1.3rem clamp(1rem,3vw,2rem); margin:0 0 1.2rem; border-radius:.75rem; background:#fff; border:1px solid #d6e0eb }
header { background:#142941; color:#fff }
h1,h2,h3 { margin:0 0 .7rem; line-height:1.25 }
nav { display:flex; flex-wrap:wrap; gap:.4rem 1rem; margin:0 0 1rem }
nav a,a { color:#005783 }
article, details { border:1px solid #d6e0eb; padding:.75rem; border-radius:.4rem; margin:.5rem 0; overflow-wrap:anywhere }
summary { cursor:pointer; font-weight:650 }
table { width:100%; border-collapse:collapse }
.table { overflow:auto }
td,th { padding:.4rem; text-align:left; border-bottom:1px solid #d6e0eb }
dt { font-weight:650 }
dd { margin:0 0 .4rem; overflow-wrap:anywhere }
code,pre { white-space:pre-wrap; overflow-wrap:anywhere }
.warning { color:#8e3012; font-weight:650 }
.chain { font-family:ui-monospace,monospace; font-size:.9rem }
.edge { color:#5b6b7e; font-size:.8rem }
.verdict { display:inline-block; padding:.1rem .5rem; border-radius:1rem; font-size:.8rem; font-weight:650; background:#e8eef5 }
.v-relevant { background:#fde2df; color:#8e1d12 } .v-likely_relevant { background:#fdf0d5; color:#7a4a00 }
.v-low_relevance { background:#e3f3e8; color:#1d5e33 } .v-unknown { background:#e8eef5; color:#33475e }
</style>
</head>
<body>
<header>
<h1>Guardian scan report</h1>
<dl>
<dt>Target</dt><dd>{{ scan.target }}</dd>
<dt>Commit</dt><dd>{{ scan.commit_sha }}</dd>
<dt>Lockfile hash</dt><dd>{{ scan.lockfile_hash }}</dd>
<dt>Inventory resolution</dt><dd>{{ scan.resolution }}</dd>
<dt>Scan status</dt><dd>{{ scan.status }}</dd>
<dt>AI status</dt><dd>{{ scan.llm_status }}</dd>
<dt>Tool versions</dt><dd>{% for name, version in scan.scanner_versions.items() %}{{ name }} {{ version }}{% if not loop.last %}, {% endif %}{% else %}UNKNOWN{% endfor %}</dd>
<dt>Database dates</dt><dd>{% for name, date in scan.db_built_at.items() %}{{ name }} {{ date }}{% if not loop.last %}, {% endif %}{% else %}UNKNOWN{% endfor %}</dd>
{% if scan.cached_age_minutes is defined and scan.cached_age_minutes is not none %}<dt>Cache</dt><dd>Reused a scan from {{ scan.cached_age_minutes|round(1) }} minutes ago.</dd>{% endif %}
{% if scan.errors is defined and scan.errors %}<dt>Stage issues</dt>{% for stage, issue in scan.errors.items() %}<dd>{{ stage }} — {{ issue }}</dd>{% endfor %}{% endif %}
</dl>
</header>
<nav aria-label="Report sections">
<a href="#inventory">SBOM</a><a href="#paths">How vulnerabilities enter</a><a href="#vulnerabilities">Ranked by relevance</a><a href="#suspicious">Suspicious packages</a><a href="#ai">AI analysis</a><a href="#fixes">Fix proposals</a><a href="#trace">Agent trace</a><a href="#coverage">Coverage</a><a href="#unknowns">Unknowns</a>
</nav>
<main>
<section id="inventory"><h2>SBOM and inventory</h2>
<p>{{ components|length }} graph components. {% if has_sbom %}<a href="sbom.cdx.json" download>Download CycloneDX SBOM</a>{% else %}SBOM unavailable.{% endif %}</p>
<ul>{% for name, row in coverage.ecosystems.items() %}<li>{{ name }} — {{ row.components }} components</li>{% endfor %}</ul>
</section>
{% macro evidence_for(ids) %}
{% if ids %}<ul>
{% for id in ids %}
{% set record = evidence.get(id) %}
{% if record %}
{% set item = record.item %}
<li>{{ item.tool }} {{ item.tool_version }} — {% if record.href %}<a href="{{ record.href }}">{{ item.file }}</a>{% else %}{{ item.file }}{% endif %} <code>{{ item.pointer }}</code><br>SHA-256 <code>{{ item.sha256 }}</code>
{% if item.url %}<br>Advisory source <code>{{ item.url }}</code>{% endif %}
{% if record.diff %}<pre>{{ record.diff }}</pre>{% endif %}</li>
{% else %}<li>Missing evidence record <code>{{ id }}</code></li>{% endif %}
{% endfor %}
</ul>{% else %}<p>Evidence unavailable.</p>{% endif %}
{% endmacro %}
{% macro risk(finding) %}
<p>Risk <strong>{{ finding.risk_level or "UNKNOWN" }}</strong> · Rule {{ finding.risk_rule_id or "UNKNOWN" }} · Confidence {{ finding.confidence or "UNKNOWN" }} · State {{ finding.state }}.</p>
{% if finding.risk_note is defined and finding.risk_note %}<p class="warning">{{ finding.risk_note }}</p>{% endif %}
{% endmacro %}
{% macro verdict(finding) %}{% if finding.relevance %}<span class="verdict v-{{ finding.relevance.verdict }}">{{ finding.relevance.verdict|replace("_", " ") }}</span>{% else %}<span class="verdict v-unknown">not assessed</span>{% endif %}{% endmacro %}
<section id="paths"><h2>How each vulnerability enters the application</h2>
<p>Every hop comes from the lockfile resolver or the SBOM; the label after each arrow shows which. Paths that could not be resolved are shown as UNKNOWN.</p>
{% for row in entries %}{% set finding = row.finding %}
<article><h3>{{ finding.advisory_id or finding.purl }} {{ verdict(finding) }}</h3>
<p class="chain">{% for hop in row.hops %}{{ hop.label }}{% if hop.edge %} <span class="edge">→ ({{ hop.edge }})</span> {% endif %}{% else %}UNKNOWN path{% endfor %}</p>
<p>Introduced by <strong>{{ row.introduced_by or "UNKNOWN" }}</strong> · {{ finding.path_count if finding.path_count is number else "UNKNOWN" }} path(s) into the application.</p></article>
{% else %}<p>No vulnerabilities to trace.</p>{% endfor %}
</section>
<section id="vulnerabilities"><h2>Vulnerabilities ranked by relevance</h2>
<p>Relevance is decided by code from recorded signals: relevant, likely relevant, unknown, low relevance. It never declares a finding safe.</p>
{% for finding in findings %}
{% set component = components.get(finding.component_id) %}
<details{% if loop.first %} open{% endif %}><summary>{{ verdict(finding) }} {{ finding.advisory_id or "UNKNOWN" }} — {{ component.name if component else finding.purl }} {{ component.version if component else "" }}</summary>
{% if finding.relevance %}<p>{{ finding.relevance.summary }}</p>
<div class="table"><table><thead><tr><th>Signal</th><th>Value</th><th>Detail</th><th>Evidence</th></tr></thead><tbody>
{% for signal in finding.relevance.signals %}<tr><td>{{ signal.name|replace("_", " ") }}</td><td><strong>{{ signal.value }}</strong></td><td>{{ signal.detail }}</td><td>{% for id in signal.evidence_ids %}<code>{{ id[:12] }}</code> {% else %}—{% endfor %}</td></tr>{% endfor %}
</tbody></table></div>{% endif %}
<p>Fix {{ finding.fixed_versions|join(", ") or "UNKNOWN" }} · Aliases {{ finding.aliases|join(", ") or "UNKNOWN" }} · Source severity {{ finding.source_severity }} · Confirmed by {{ finding.confirmed_by|join(" + ") or "UNKNOWN" }}.</p>
{{ risk(finding) }}
{{ evidence_for(finding.evidence_ids) }}
</details>
{% else %}<p>No vulnerabilities reported. This is not proof the application is safe; see coverage.</p>{% endfor %}
</section>
<section id="suspicious"><h2>Suspicious and malicious packages</h2>
<p>Non-CVE risks found by rules. Packages marked SYNTHETIC are inert test fixtures.</p>
{% for finding in suspicious %}<article><h3>{{ finding.anomaly_type or "malicious package" }} — {{ finding.purl }}</h3>
{{ risk(finding) }}{{ evidence_for(finding.evidence_ids) }}</article>
{% else %}<p>No suspicious packages reported. See coverage for detector results.</p>{% endfor %}
</section>
<section id="ai"><h2>AI analysis</h2>
<p>AI status {{ scan.llm_status }}. Every claim below was checked by code against the evidence it cites.</p>
{% for title, claims in [("Accepted evidence claims", accepted), ("AI inferences", inferences), ("Rejected claims", rejected)] %}
<h3>{{ title }}</h3>{% for claim in claims %}<article><p><strong>{{ claim.step|replace("_", " ") }}:</strong> {{ claim.text }}</p>
{% if claim.rejected_reason %}<p>Reason: {{ claim.rejected_reason }}</p>{% endif %}
{% if claim.uncertainty and claim.uncertainty != "UNKNOWN" %}<p>Uncertainty: {{ claim.uncertainty }}</p>{% endif %}
{% if claim.evidence_ids %}{{ evidence_for(claim.evidence_ids) }}{% endif %}
</article>{% else %}<p>None recorded.</p>{% endfor %}
{% endfor %}
</section>
<section id="fixes"><h2>Fix proposals (human approval required)</h2>
<p>Nothing is applied automatically. Each proposal must be approved, then built, tested and rescanned in a sandbox branch.</p>
{% for claim in fixes %}<article><p><strong>{{ "Proposed" if claim.validated else "Rejected" }}:</strong> {{ claim.text }}</p>
{% if claim.rejected_reason %}<p>Reason: {{ claim.rejected_reason }}</p>{% endif %}
{% if claim.uncertainty %}<p>{{ claim.uncertainty }}</p>{% endif %}</article>
{% else %}<p>No fix proposals (AI review off, failed, or no finding passed validation).</p>{% endfor %}
</section>
<section id="trace"><h2>Agent trace</h2>
{% if trace %}<div class="table"><table><thead><tr><th>Agent</th><th>Consumed</th><th>Produced</th><th>Accepted</th><th>Rejected</th><th>LLM calls</th><th>Note</th></tr></thead><tbody>
{% for step in trace %}<tr><td>{{ step.agent|replace("_", " ") }}</td><td>{{ step.consumed|length }}</td><td>{{ step.produced|length }}</td><td>{{ step.accepted }}</td><td>{{ step.rejected }}</td><td>{{ step.llm_calls }}</td><td>{{ step.error or "" }}</td></tr>{% endfor %}
</tbody></table></div>{% else %}<p>The AI review did not run for this scan.</p>{% endif %}
</section>
<section id="coverage"><h2>Coverage</h2>
{% for warning in coverage.warnings %}<p class="warning">{{ warning }}</p>{% endfor %}
{% if coverage.ecosystems %}<div class="table"><table><caption>Ecosystem inventory and matching</caption><thead><tr><th>Ecosystem</th><th>Components</th><th>Resolver edges</th><th>Scanner matches</th></tr></thead><tbody>
{% for name, row in coverage.ecosystems.items() %}<tr><td>{{ name }}</td><td>{{ row.components }}</td><td>{{ "%.1f"|format(row.resolver_percent) }}%</td><td>{{ "%.1f"|format(row.scanner_percent) }}%</td></tr>{% endfor %}
</tbody></table></div>{% endif %}
{% if coverage.rows %}<div class="table"><table><caption>Detector results</caption><thead><tr><th>Detector</th><th>Ecosystem</th><th>Status</th><th>Components</th><th>Reason</th></tr></thead><tbody>
{% for row in coverage.rows %}<tr><td>{{ row.detector }}</td><td>{{ row.ecosystem }}</td><td>{{ row.status }}</td><td>{{ row.components_seen }}</td><td>{{ row.reason or "UNKNOWN" }}</td></tr>{% endfor %}
</tbody></table></div>{% else %}<p>No detector coverage recorded.</p>{% endif %}
</section>
<section id="unknowns"><h2>Remaining unknowns and limitations</h2>
<ul>{% for item in unknowns %}<li>{{ item }}</li>{% endfor %}</ul>
</section>
</main>
</body>
</html>
